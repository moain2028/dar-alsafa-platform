SQLJS_AUTO_SAVE=true
SQLJS_LOCATION=./data/dar-alsafa.sql
DB_SYNCHRONIZE=true
SEED_DEMO=true
DEMO_PASSWORD=DarAlsafa!2026
DEFAULT_VAT_NUMBER=310123456700003
PAYMENTS_DRIVER=mock
ZATCA_MODE=development
ZATCA_SELLER_NAME=مطاعم دار الصفاء
